// 영역: 동의 — 동의서 버전·동의 항목, 약관 동의, 개인정보 동의, 14세 미만 서면 동의서, 선생님 가입 고지 확인

Table consent_documents {
  id uuid [pk, note: '서버에서 UUID v7']
  document_kind varchar(30) [not null, note: '문서 종류. STUDENT_PRIVACY / GUARDIAN_PRIVACY / GUARDIAN_FORM / TERMS / PRIVACY_POLICY / PROCESSING_AGREEMENT / TEACHER_NOTICE (가칭)']
  version varchar(50) [not null, note: '버전 이름. 예: 학생 동의서 v1 (2026-11)']
  body text [not null, note: '문안 원문. 학원명 자리 포함. 처리방침은 게시본 사본. 게시 전 빈칸·임시 값 검사. Flyway 시드로 넣지 않고 운영자 관리 기능으로 게시(개발 서버는 가짜 문안만)']
  change_kind varchar(30) [note: '이전 버전과 비교한 변경 종류. NOTICE_ONLY / RECONSENT_REQUIRED / OPTIONAL_ITEMS_CHANGED / UNFAVORABLE (가칭). 첫 버전은 NULL']
  change_summary text [note: '조항별 요약. v2.0 · NULL 허용. v2.0 바뀐 내용 안내에 씀']
  effective_at timestamptz [not null, note: '적용일. 재동의 미응답 30일은 이 값에서 계산(학생마다 저장 안 함). 적용일이 지나야 앱·웹에 내려감']
  published_at timestamptz [note: '게시 시각. NULL = 게시 전 초안(앱·웹에 내려가지 않음). 게시한 행은 고치지 않고 새 버전으로']
  published_by_user_id uuid [note: '게시한 운영자. → [외부] `users.id` 참조 예정(단일 FK)']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, note: '서버가 채움']
  Indexes {
    (document_kind, version) [unique]
  }
  Note: '동의서·약관·고지·위탁 문서의 버전(서버가 내려주는 문안) · v1.0 · 가칭. 전역 테이블(운영자 전용). 동의 기록이 이 행을 가리킴. 앱·웹 API는 published_at IS NOT NULL AND effective_at ≤ now()인 행 가운데 종류별 최신만 내려줌(게시 전 문안은 내려가지 않음). 게시한 행(published_at이 채워진 행)은 동의 근거라 BEFORE UPDATE 트리거로 고치지 못하게 막고, 고치려면 새 버전을 만듦. 게시 상태 enum은 두지 않음(개발 총괄 11/22)'
}

Table consent_document_items {
  id uuid [pk, note: '서버에서 UUID v7']
  consent_document_id uuid [not null, note: '문서. → `consent_documents.id`']
  consent_type varchar(30) [not null, note: '동의 종류. ConsentType 값']
  required boolean [not null, note: '필수 여부']
  label varchar(100) [not null, note: '항목 문구']
  sort_order int [not null, note: '보여 주는 순서']
  release varchar(10) [note: '이 항목이 보이는 출시 버전. 예: 1.1. 꺼진 버전이면 숨기고 값이 와도 거절. 이름은 1.0.46 설계 때']
  feature_switch varchar(40) [note: '필요한 기능 스위치. 예: allow_guardian. 꺼져 있으면 숨김']
  required_plan varchar(20) [note: '필요한 요금제. v3.0 · NULL 허용. AI 판독 항목은 PREMIUM 학원에만 보임(가칭)']
  created_at timestamptz [not null, default: `now()`]
  Indexes {
    (consent_document_id, consent_type) [unique]
  }
  Note: '문서별 동의 항목(필수·선택, 문구) — 동의 화면을 서버가 그리게 함 · v1.0 · 가칭. 전역. 문서를 게시하면 항목도 고정'
}

Table terms_consents {
  id uuid [pk, note: '서버에서 UUID v7']
  user_id uuid [not null, note: '동의한 계정. → [외부] `users.id` 참조 예정(단일 FK)']
  consent_document_id uuid [not null, note: '약관 버전(TERMS). → `consent_documents.id`']
  agreed_at timestamptz [not null, note: '동의 시각']
  client_type varchar(10) [not null, note: '동의한 곳. APP / WEB']
  os_name varchar(20) [note: 'OS 종류. 기기 고유 ID·IP는 저장하지 않음']
  os_version varchar(30) [note: 'OS 버전']
  app_version varchar(30) [note: '앱 버전']
  created_at timestamptz [not null, default: `now()`]
  Indexes {
    (user_id, agreed_at)
  }
  Note: '이용약관 동의(계정 단위) · v1.0 · TermsConsent. 계정 단위·쌓기만 함. 계정 삭제 때 함께 삭제(애플은 연결 해지 뒤)'
}

Table membership_consents {
  id uuid [pk, note: '서버에서 UUID v7']
  organization_id uuid [not null, note: '학원 격리. → [외부] organizations.id']
  membership_id uuid [not null, note: '동의한 사람의 소속. → [외부] `memberships.id` 참조 예정(복합 FK). 학생 소속. 보호자 본인 항목(v1.3)이면 보호자 소속']
  consent_type varchar(30) [not null, note: '동의 종류. REQUIRED / GUARDIAN_VIEW / EXAM_SCORE / GUARDIAN_CONSENT. 등원 알림(v2.3)·AI 판독(v3.0) 값은 그 설계 때']
  agreed boolean [not null, note: '동의 여부. 선택 항목을 고르지 않은 것도 false로 남김']
  consent_document_id uuid [not null, note: '보여 준 동의서 버전. → `consent_documents.id`']
  document_hash varchar(64) [note: '최종 문안 해시. 학원명을 채운 문안의 SHA-256. 서면은 NULL']
  method varchar(20) [not null, note: '동의 방식. ELECTRONIC / WRITTEN']
  actor varchar(20) [not null, note: '입력 주체. SELF / DIRECTOR / OPERATOR']
  entered_by_membership_id uuid [note: '입력한 원장. → [외부] `memberships.id` 참조 예정(복합 FK). actor = DIRECTOR일 때']
  entered_by_user_id uuid [note: '입력한 운영자. → [외부] `users.id` 참조 예정(단일 FK). actor = OPERATOR일 때']
  guardian_consent_form_id uuid [note: '14세 미만 서면 동의서. v1.3 · NULL 허용. → `guardian_consent_forms.id` (복합 FK). 같은 서류로 고른 항목들이 같은 값']
  guardian_link_id uuid [note: '보호자 연결. v2.3 · NULL 허용. → [외부] `guardian_links.id` 참조 예정(복합 FK). 보호자 등원 알림 동의는 보호자 연결 단위']
  consented_at timestamptz [not null, note: '동의 시각. 전자 = 누른 시각, 서면 = 원장이 입력한 시각']
  os_name varchar(20) [note: 'OS 종류. 전자 동의만']
  os_version varchar(30) [note: 'OS 버전']
  app_version varchar(30) [note: '앱 버전']
  withdrawn_at timestamptz [note: '철회 시각. 한 번만 채움']
  withdraw_channel varchar(20) [note: '철회를 받은 방법. APP / IN_PERSON / PHONE / WRITTEN / LINK_ENDED(v2.3, 보호자 연결 해제로 끝남) (가칭). 14세 미만 철회는 말·전화로도 받음']
  withdrawn_by_membership_id uuid [note: '철회를 입력한 원장. → [외부] `memberships.id` 참조 예정(복합 FK)']
  invalidated_at timestamptz [note: '무효 표시 시각. v1.3 · NULL 허용. 생년월일 정정 뒤 법정대리인 동의로 풀릴 때 이전 본인 동의를 무효로 표시']
  created_at timestamptz [not null, default: `now()`]
  Indexes {
    (membership_id, consent_type, consented_at)
  }
  Note: '개인정보 동의 이력(소속 단위, 항목 하나당 한 행) · v1.0 · MembershipConsent. 쌓기만 함. UPDATE는 withdrawn_at·withdraw_channel·withdrawn_by_membership_id·invalidated_at만 허용하고, BEFORE UPDATE 트리거로 이 4칸이 NULL에서 값으로만 바뀌게 함. CHECK (withdrawn_at IS NULL OR agreed). 지금 상태 = (소속, 종류, 보호자 연결)별 최신 행 하나만 보고, 그 행이 agreed이고 철회·무효가 아니면 동의. guardian_link_id는 보호자 등원 알림 동의(v2.3)일 때만 채우고 그 밖에는 NULL(개발 총괄 11/22). 학생 데이터와 함께 삭제'
}

Table guardian_consent_forms {
  id uuid [pk, note: '서버에서 UUID v7']
  organization_id uuid [not null, note: '학원 격리. → [외부] organizations.id']
  student_id uuid [not null, note: '학생 소속. → [외부] `memberships.id` 참조 예정(복합 FK)']
  consent_document_id uuid [not null, note: '동의서 양식 버전(GUARDIAN_FORM). → `consent_documents.id`']
  guardian_name varchar(50) [not null, note: '법정대리인 이름']
  guardian_relation varchar(30) [not null, note: '학생과의 관계. FATHER / MOTHER / LEGAL_GUARDIAN만']
  written_date date [not null, note: '동의서 작성일']
  received_date date [not null, note: '받은 날']
  received_channel varchar(20) [not null, note: '받은 방법. DIRECT / PHOTO_SCAN (가칭)']
  verification_method varchar(20) [not null, note: '법정대리인 확인 방법. IN_PERSON / PHONE']
  record_match_confirmed boolean [not null, note: '원생 기록의 보호자와 같은 분임을 확인. CHECK (record_match_confirmed): true만 받음']
  entered_by uuid [not null, note: '입력한 원장. → [외부] `memberships.id` 참조 예정(복합 FK)']
  entered_at timestamptz [not null, note: '입력 시각']
  created_at timestamptz [not null, default: `now()`]
  Indexes {
    (organization_id, id) [unique]
    (student_id, entered_at)
  }
  Note: '14세 미만 법정대리인 서면 동의서(원장이 입력) · v1.3 · 가칭. 원본·사진 업로드와 법정대리인 전화번호는 받지 않음. 학생 데이터와 함께 삭제'
}

Table teacher_notice_acknowledgements {
  id uuid [pk, note: '서버에서 UUID v7']
  organization_id uuid [not null, note: '학원 격리. → [외부] organizations.id']
  membership_id uuid [not null, note: '선생님 소속. → [외부] `memberships.id` 참조 예정(복합 FK). 선생님 역할만 있고 원장 역할이 없는 소속']
  consent_document_id uuid [not null, note: '고지 버전(TEACHER_NOTICE). → `consent_documents.id`']
  acknowledged_at timestamptz [not null, note: '확인 시각']
  created_at timestamptz [not null, default: `now()`]
  Indexes {
    (membership_id, consent_document_id) [unique]
  }
  Note: '선생님 가입 고지 확인 · v1.0 · 가칭. 소속 해제 23일째 함께 삭제'
}

Ref: consent_document_items.consent_document_id > consent_documents.id
Ref: terms_consents.consent_document_id > consent_documents.id
Ref: membership_consents.consent_document_id > consent_documents.id
Ref: membership_consents.(organization_id, guardian_consent_form_id) > guardian_consent_forms.(organization_id, id)
Ref: guardian_consent_forms.consent_document_id > consent_documents.id
Ref: teacher_notice_acknowledgements.consent_document_id > consent_documents.id
