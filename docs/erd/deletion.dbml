// 영역: 삭제 — 자동 삭제 작업 실행 기록, 지운 데이터 ID 목록

Table deletion_runs {
  id uuid [pk, note: '서버에서 UUID v7']
  job_type varchar(40) [not null, note: '작업 종류. MEMBERSHIP_DATA / SUBMISSION_PHOTOS / WORKSHEET_FILES / INVITATIONS / UNAPPROVED_SIGNUPS / ORPHAN_ACCOUNTS / ORGANIZATION_PURGE / LOG_EXPIRY(기록·위탁 동의 등 보관 기간 만료) / NOTIFICATIONS(90일) / ACCOUNT_DELETION(계정 삭제 뒤 학원을 가로지르는 정리, 예: reported_user_id 비우기) / GUARDIAN_LINKS(v1.3) / SCHEDULES(v2.3) / MESSAGES(v3.2) / TUTOR_SIGNUPS(v3.3) (가칭)']
  organization_id uuid [note: '학원. 값만 저장(FK 없음)']
  deleted_count int [not null, note: '지운 건수']
  started_at timestamptz [not null, note: '시작 시각']
  finished_at timestamptz [not null, note: '끝난 시각']
  result varchar(20) [not null, note: '결과. SUCCEEDED / FAILED']
  error_code varchar(40) [note: '오류 코드']
  created_at timestamptz [not null, default: `now()`]
  Indexes {
    (organization_id, started_at)
    (job_type, started_at)
  }
  Note: '자동 삭제 작업 실행 기록 · v1.0 · 가칭. 쌓기만 함. 이름 없음. 처리 현황 확인서(연 1회)와 파기 근거. 실행일부터 3년 보관(법무 11/21). 사유 칸은 두지 않음(법무 L-02 11/22, 종료 사유는 삭제 전까지 소속 행의 end_reason에 있음). 지운 행의 ID는 남기지 않음(복원 대비 ID 목록은 deletion_tombstones)'
}

Table deletion_tombstones {
  id uuid [pk, note: '서버에서 UUID v7']
  target_type varchar(40) [not null, note: '대상 종류. 지운 대상의 종류. 값 목록은 설계 때(7장)']
  target_id uuid [not null, note: '대상 ID. 값만 저장(FK 없음)']
  organization_id uuid [note: '학원. 값만 저장(FK 없음). 학원이 없는 대상(계정 등)은 NULL']
  deleted_at timestamptz [not null, note: '지운 시각. 숨김 표시가 아니라 실제로 지운 시각. 이 시각 + 8일이 지나면 이 행도 지움']
  created_at timestamptz [not null, default: `now()`]
  Indexes {
    deleted_at
  }
  Note: '삭제 ID 목록(백업에서 복원한 뒤 삭제를 다시 돌리는 근거) · v1.0 · 가칭. 삭제 작업이 대상을 지울 때 같은 트랜잭션에서 대상마다 한 행을 넣음. 이름 없음, FK 없음. 백업에서 복원하면 이 목록으로 삭제를 다시 돌림. 백업이 7일 뒤 사라지므로 지운 날부터 8일이 지나면 지움(법무 L-08·용어집 보관표 11/23). 백업 복원 뒤 다시 지우는 데만 쓰고 다시 가입 막기·통계에는 쓰지 않음. 복원한 DB는 다시 지우기를 마친 뒤에 서비스에 연결함. 학원 칸이 있지만 RLS를 걸지 않고 RLS 누락 검사의 허용 목록에 넣음. 요청 경로 역할에는 권한이 없고(SELECT·INSERT도 없음) 삭제 작업 역할만 넣고 지움. deletion_runs는 건수 기록이라 따로 둠(개발 총괄 11/22)'
}
