// 영역: 공지 — 공지·받는 역할·수정 기록·읽음, 바뀐 내용 안내 확인

Table notices {
  id uuid [pk, note: '서버에서 UUID v7']
  type varchar(30) [not null, note: '공지 종류. 약관·처리방침 변경 / 서비스 종료 / 일반 (값 이름은 1.3.29 설계 때)']
  change_mark varchar(30) [note: '변경 표시. 약관의 불리한 변경 / 처리방침의 중요한 변경 (가칭)']
  consent_document_id uuid [note: '바뀌는 약관·처리방침 버전. → `consent_documents.id`']
  title varchar(100) [not null, note: '제목']
  body text [not null, note: '본문. 처리방침 중요한 변경은 전후 대조표 포함']
  banner_starts_at timestamptz [not null, note: '배너 게시 시작']
  banner_ends_at timestamptz [not null, note: '배너 게시 끝']
  effective_at timestamptz [note: '적용일. 배너를 닫아도 적용일까지 알림함·공지 목록에 남음']
  published_at timestamptz [note: '게시 시각']
  created_by_user_id uuid [not null, note: '쓴 운영자. → [외부] `users.id` 참조 예정(단일 FK)']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, note: '서버가 채움']
  Note: '공지(운영자 작성) · v1.3 · Notice. 전역(운영자 전용). 받는 사람: 변경·서비스 종료는 전체 고정, 일반만 역할을 고름. 앱 알림은 불리한 약관 변경·서비스 종료에만'
}

Table notice_audience_roles {
  id uuid [pk, note: '서버에서 UUID v7']
  notice_id uuid [not null, note: '공지. → `notices.id`']
  role varchar(20) [not null, note: '역할. MembershipRole']
  created_at timestamptz [not null, default: `now()`]
  Indexes {
    (notice_id, role) [unique]
  }
  Note: '일반 공지의 받는 역할 · v1.3 · 가칭'
}

Table notice_revisions {
  id uuid [pk, note: '서버에서 UUID v7']
  notice_id uuid [not null, note: '공지. → `notices.id`']
  title varchar(100) [not null, note: '그때 제목']
  body text [not null, note: '그때 본문']
  revised_by_user_id uuid [not null, note: '고친 운영자. → [외부] `users.id` 참조 예정(단일 FK)']
  created_at timestamptz [not null, default: `now()`]
  Indexes {
    (notice_id, created_at)
  }
  Note: '공지 수정 기록(공지 기한을 지켰다는 근거) · v1.3 · 가칭. 쌓기만 함'
}

Table notice_reads {
  id uuid [pk, note: '서버에서 UUID v7']
  notice_id uuid [not null, note: '공지. → `notices.id`']
  user_id uuid [not null, note: '계정. → [외부] `users.id` 참조 예정(단일 FK)']
  read_at timestamptz [note: '읽은 시각']
  banner_dismissed_at timestamptz [note: '배너를 닫은 시각']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, note: '서버가 채움']
  Indexes {
    (notice_id, user_id) [unique]
  }
  Note: '공지 읽음·배너 닫기(계정별) · v1.3 · 가칭. 처음 읽거나 닫을 때 행을 만듦. 받는 사람 목록 자체는 공지 대상 규칙으로 계산'
}

Table terms_change_acknowledgements {
  id uuid [pk, note: '서버에서 UUID v7']
  user_id uuid [not null, note: '계정. → [외부] `users.id` 참조 예정(단일 FK)']
  consent_document_id uuid [not null, note: '약관 버전. → `consent_documents.id`']
  shown_at timestamptz [not null, note: '보여 준 시각']
  acknowledged_at timestamptz [note: '[확인]·✕를 누른 시각. 동의가 아니라 알렸다는 기록']
  created_at timestamptz [not null, default: `now()`]
  Indexes {
    (user_id, consent_document_id) [unique]
  }
  Note: '바뀐 내용 안내 확인(불리한 약관 변경) · v2.0 · 가칭. 기기 정보·IP 없음. 계정 삭제 때 함께 삭제'
}

Ref: notices.consent_document_id > consent_documents.id
Ref: notice_audience_roles.notice_id > notices.id [delete: cascade]
Ref: notice_revisions.notice_id > notices.id
Ref: notice_reads.notice_id > notices.id [delete: cascade]
Ref: terms_change_acknowledgements.consent_document_id > consent_documents.id
