// 영역: 수행 기록 — 수행 기록과 수정 이력

Table performance_records {
  id uuid [pk, note: '서버에서 UUID v7']
  organization_id uuid [not null, note: '학원 격리. → [외부] organizations.id']
  homework_id uuid [not null, note: '숙제. → [외부] `homeworks.id` 참조 예정(복합 FK). 숙제는 학생마다 한 행이라 기록도 숙제당 하나']
  result varchar(20) [not null, note: '수행 결과. COMPLETE / PARTIAL / INCOMPLETE / EXEMPT']
  state varchar(20) [not null, note: '상태. PROPOSED / CONFIRMED']
  proposed_at timestamptz [note: '미리 채운 시각. 사진 제출이 필요 없는 숙제는 NULL(선생님이 바로 확정)']
  confirmed_at timestamptz [note: '확정 시각']
  confirmed_by uuid [note: '확정자. → [외부] `memberships.id` 참조 예정(복합 FK). 담당이 넘어가도 바뀌지 않음']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, note: '서버가 채움']
  Indexes {
    (organization_id, id) [unique]
    homework_id [unique]
    (organization_id, state)
  }
  Note: '수행 기록(숙제당 한 행) · v1.1 · PerformanceRecord. CHECK: state = CONFIRMED이면 confirmed_at·confirmed_by가 있어야 함. 미기록 = 행 없음 또는 PROPOSED'
}

Table performance_record_histories {
  id uuid [pk, note: '서버에서 UUID v7']
  organization_id uuid [not null, note: '학원 격리. → [외부] organizations.id']
  performance_record_id uuid [not null, note: '수행 기록. → `performance_records.id` (복합 FK)']
  previous_result varchar(20) [not null, note: '고치기 전 값']
  new_result varchar(20) [not null, note: '고친 뒤 값']
  changed_by uuid [not null, note: '고친 사람. → [외부] `memberships.id` 참조 예정(복합 FK). 책임 선생님만']
  changed_at timestamptz [not null, note: '고친 시각']
  created_at timestamptz [not null, default: `now()`]
  Indexes {
    (performance_record_id, changed_at)
  }
  Note: '수행 기록 수정 이력(확정 뒤 고친 것) · v1.1 · 가칭. 쌓기만 함. ’수정됨’ 표시는 이 행이 있는지로 판단'
}

Ref: performance_record_histories.(organization_id, performance_record_id) > performance_records.(organization_id, id) [delete: cascade]
