// 영역: 판독 — AI 판독 결과, 유형 분석, 재촬영 요청

Table ai_screening_results {
  id uuid [pk, note: '서버에서 UUID v7']
  organization_id uuid [not null, note: '학원 격리. → [외부] organizations.id']
  submission_id uuid [not null, note: '제출. → [외부] `submissions.id` 참조 예정(복합 FK)']
  photo_position int [not null, note: '제출 안 사진 순서. 사진은 7일·30일에 지워지므로 사진 행 대신 순서로 가리킴(3.0.1에서 확정)']
  classification varchar(20) [not null, note: '분류. 정상 / 선생님 확인 필요 / 판독 불가 (값 이름은 3.0.1 설계 때)']
  confidence numeric(4,3) [note: '신뢰도']
  duplicate_detected boolean [not null, note: '중복 사진 여부. AI 판독 동의 학생 사진끼리만 비교']
  screened_at timestamptz [not null, note: '판독 시각']
  created_at timestamptz [not null, default: `now()`]
  Indexes {
    (organization_id, submission_id, photo_position) [unique]
  }
  Note: 'AI 판독 결과(분류·신뢰도·시각만) · v3.0 · 가칭. ’분류·신뢰도·시각만’은 AI가 만든 내용 기준이고, photo_position(어느 사진인지)과 duplicate_detected(서버가 찾은 중복)는 가리키는 값·서버 판정이라 둠(확정은 3.0.1, 개발 총괄 11/22). AI가 만든 설명 글은 저장하지 않음. 동의 철회하면 즉시 삭제, 학생이 사진 묶음을 바꾸면 그 제출의 결과도 삭제, 프리미엄이 끝나면 숨기기만. 비교용 값의 저장 위치는 3.0.1'
}

Table problem_analyses {
  id uuid [pk, note: '서버에서 UUID v7']
  organization_id uuid [not null, note: '학원 격리. → [외부] organizations.id']
  submission_id uuid [not null, note: '제출. → [외부] `submissions.id` 참조 예정(복합 FK)']
  problem_number varchar(20) [not null, note: '문항 번호']
  correct boolean [note: '정오']
  problem_type varchar(50) [note: '유형 코드']
  analyzed_at timestamptz [not null, note: '분석 시각']
  created_at timestamptz [not null, default: `now()`]
  Note: '유형 분석(문항 번호·정오·유형만) · v3.1 · 가칭. 문제 지문은 저장하지 않음. AI 판독 동의 학생의 제출만. 삭제 계기는 AI 판독 결과와 같게: 동의 철회하면 즉시, 학생이 사진 묶음을 바꾸면 그 제출의 분석도, 숙제·학생 데이터와 함께 삭제, 프리미엄이 끝나면 숨기기만(보관 문구라 3.1.1 설계 때 법무 확인)'
}

Table retake_requests {
  id uuid [pk, note: '서버에서 UUID v7']
  organization_id uuid [not null, note: '학원 격리. → [외부] organizations.id']
  homework_id uuid [not null, note: '숙제(학생마다 따로 있는 숙제). → [외부] `homeworks.id` 참조 예정(복합 FK)']
  requested_by uuid [not null, note: '요청한 책임 선생님. → [외부] `memberships.id` 참조 예정(복합 FK)']
  reason varchar(20) [not null, note: '사유. BLURRY / CROPPED / WRONG_PAGE (가칭: 사진이 흐려요 / 일부가 잘렸어요 / 다른 페이지예요). 글 칸 없음']
  requested_at timestamptz [not null, note: '요청 시각. 마감 전에만(서버 검사)']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, note: '서버가 채움']
  Indexes {
    (organization_id, homework_id) [unique]
  }
  Note: '재촬영 요청(숙제마다 마지막 요청만) · v3.0 · 가칭. 다시 요청하면 같은 행의 requested_by·reason·requested_at을 함께 바꿈(마지막 요청만 보여 줌). AI 판독 동의와 관계없이 모든 학생에게 보낼 수 있음. 다시 냈는지는 저장하지 않고 요청 시각 뒤에 확정된 제출이 있는지로 계산하고, 다시 내지 않고 마감이 지나면 그 수행 기록을 일괄 확정에서 뺌(계산). 학생 푸시는 notifications(고정 문구). 숙제·학생 데이터와 함께 삭제'
}
